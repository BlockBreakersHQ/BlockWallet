{
    "app-id": "org.BlockBreakers.Wallet",
    "runtime": "org.gnome.Platform",
    "runtime-version": "47",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm18"
    ],
    "command": "block_wallet",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.secrets"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm18/bin",
        "env": {
            "CARGO_HOME": "/run/build/block-wallet/cargo",
            "RUSTFLAGS": "-C link-arg=-fuse-ld=lld"
        },
        "build-args": [
            "--share=network"
        ]
    },
    "modules": [
        {
            "name": "block-wallet",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --locked --offline || cargo build --release --locked",
                "install -Dm755 ./target/release/block_wallet /app/bin/block_wallet",
                "install -Dm644 data/org.BlockBreakers.Wallet.desktop /app/share/applications/org.BlockBreakers.Wallet.desktop",
                "install -Dm644 data/org.BlockBreakers.Wallet.metainfo.xml /app/share/metainfo/org.BlockBreakers.Wallet.metainfo.xml",
                "install -Dm644 data/icons/hicolor/256x256/apps/org.BlockBreakers.Wallet.png /app/share/icons/hicolor/256x256/apps/org.BlockBreakers.Wallet.png",
                "mkdir -p /app/share/blockwallet",
                "cp -a Images /app/share/blockwallet/Images"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                }
            ]
        }
    ]
}
