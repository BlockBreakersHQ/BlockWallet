{
    "//": "PureOS Store manifest. Same pinned tag as the Flathub release, built against",
    "//2": "sm.puri.Platform, which PureOS requires: https://storage.puri.sm/pureos-policy/",
    "//3": "Ships 64x64 and 128x128 icons on top of 256x256, which PureOS requires.",
    "//4": "BLOCKED: sm.puri.Sdk 44 was last built 2023-03-28 and its rust-stable extension is 22.08 (rustc ~1.69). This crate declares rust-version 1.85, so it cannot build until Purism refresh the runtime. See docs/packaging.md.",
    "app-id": "io.github.BlockBreakersHQ.BlockWallet",
    "runtime": "sm.puri.Platform",
    "runtime-version": "44",
    "sdk": "sm.puri.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "block_wallet",
    "finish-args": [
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--talk-name=org.freedesktop.secrets"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/block-wallet/cargo"
        }
    },
    "modules": [
        {
            "name": "block-wallet",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --locked --offline",
                "install -Dm755 ./target/release/block_wallet /app/bin/block_wallet",
                "install -Dm644 data/io.github.BlockBreakersHQ.BlockWallet.desktop /app/share/applications/io.github.BlockBreakersHQ.BlockWallet.desktop",
                "install -Dm644 data/io.github.BlockBreakersHQ.BlockWallet.metainfo.xml /app/share/metainfo/io.github.BlockBreakersHQ.BlockWallet.metainfo.xml",
                "install -Dm644 data/icons/hicolor/256x256/apps/io.github.BlockBreakersHQ.BlockWallet.png /app/share/icons/hicolor/256x256/apps/io.github.BlockBreakersHQ.BlockWallet.png",
                "install -Dm644 data/icons/hicolor/128x128/apps/io.github.BlockBreakersHQ.BlockWallet.png /app/share/icons/hicolor/128x128/apps/io.github.BlockBreakersHQ.BlockWallet.png",
                "install -Dm644 data/icons/hicolor/64x64/apps/io.github.BlockBreakersHQ.BlockWallet.png /app/share/icons/hicolor/64x64/apps/io.github.BlockBreakersHQ.BlockWallet.png",
                "mkdir -p /app/share/blockwallet",
                "install -Dm644 LICENSE /app/share/licenses/$FLATPAK_ID/LICENSE",
                "cp -a Images /app/share/blockwallet/Images"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/BlockBreakersHQ/BlockWallet.git",
                    "tag": "v0.2.0",
                    "commit": "69d6ae14ccc8a7ef812c3395945f51286bd92ce0",
                    "//": "commit is filled in alongside the tag so the build is reproducible even if the tag moves"
                },
                "generated-sources.json"
            ]
        }
    ]
}
